# Copy to .env and fill in. Loaded by:  set -a; source .env; set +a
# Never commit .env — it is git-ignored.

# ── Kubernetes ───────────────────────────────────────────────────────────────
NAMESPACES=apps-stg                    # comma-separated namespaces to monitor
USE_IN_CLUSTER=false                   # false = use your local kubeconfig
# KUBECONFIG=~/.kube/config             # defaults to the standard kubeconfig
STAGE_LABEL_SELECTOR=environment=stage
POD_NAMESPACE=monitoring               # where the agent keeps its ConfigMaps

# ── Schedule ─────────────────────────────────────────────────────────────────
RUN_ONCE=true                          # true = one check then exit
INTERVAL_SECONDS=300                   # used when RUN_ONCE=false
TEST_ALERT=false                       # true = send a synthetic Teams card and exit

# ── Claude (required) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=8192

# ── Microsoft Teams — set the webhook OR all MS_GRAPH_* values ───────────────
MS_TEAMS_WEBHOOK_URL=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_REFRESH_TOKEN=
MS_GRAPH_TEAM_ID=
MS_GRAPH_CHANNEL_ID=
TEAMS_REPLY_TIMEOUT=300
TEAMS_POLL_INTERVAL=10

# ── Observability (optional — skipped when empty) ────────────────────────────
# Locally, port-forward first:  scripts/open-monitoring.sh
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=
LOKI_LOOKBACK_HOURS=1
LOKI_MAX_LINES=200
MAX_LOG_LINES=100
MAX_EVENTS=60

# ── GitOps remediation (optional, opt-in per ingress) ────────────────────────
GITHUB_TOKEN=
# GITOPS_REPO_MAP='{"apps-stg/my-ingress": {"repo": "owner/repo", "path": "values.yaml", "yaml_path": "ingress.hosts[0].host", "base_branch": "main"}}'
